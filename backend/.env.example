# SECURITY - App secrets
# Set SECRET_KEY to a long, random string in production
SECRET_KEY=
DEBUG=True

# DATABASE
# Use this for local development with SQLite
DATABASE_URL=sqlite:///db.sqlite3

# In production, you might use:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME

# M-PESA API (Mock/Sandbox/Production)
MPESA_ENV=MOCK # MOCK, SANDBOX, or PRODUCTION
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# WHATSAPP (META) API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN= # A random string you create

# AI PROVIDER (Mock/OpenAI/etc)
AI_PROVIDER=MOCK # MOCK or OPENAI
OPENAI_API_KEY=

# JWT SETTINGS
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=5
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7